# Copy this file to .env.local and replace placeholders with your real values.
# Never commit .env.local or share its contents.
# Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy fallback; prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key required for database access and app-managed authentication.
# Set SUPABASE_SECRET_KEY or the legacy SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App origins. Set AUTH_BASE_URL to the exact public origin for OAuth redirects.
AUTH_BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://luciferapi.com

# Optional social sign-in providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=

# Optional independent server-only HMAC keys. When omitted, Supabase's server key is used.
AUTH_OTP_HMAC_SECRET=
RATE_LIMIT_HMAC_SECRET=

# Required to save payout details; use a persistent 32-byte (64 hex character) server-only key.
PAYOUT_DATA_ENCRYPTION_KEY=

# Hostinger SMTP for app-managed email.
# Use a Hostinger mailbox address and its mailbox password.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Internal support/admin notification recipients; these alerts use Hostinger SMTP.
SUPPORT_TICKET_NOTIFICATION_EMAIL=
ADMIN_NOTIFICATION_EMAIL=
PROJECT_REQUEST_NOTIFICATION_EMAIL=
WITHDRAWAL_REQUEST_NOTIFICATION_EMAIL=

# Optional OpenRouter credentials for AI chat and the hero assistant.
OPENROUTER_API_KEY=
# Optional second key; takes precedence over OPENROUTER_API_KEY when set.
OPENROUTER_API_KEY_2=
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions

# Razorpay: use test keys locally and live keys in production.
# The public key is exposed to the checkout UI; keep the secret server-side.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: Cloudflare R2 storage for project images, videos, and source ZIPs.
# Set the account ID or a custom S3-compatible endpoint.
# Public bucket: media and maintenance images. Private bucket: source ZIPs, maintenance settings, and banner image metadata.
# For public media, use the bucket hostname (for example
# https://my-bucket.<account-id>.r2.cloudflarestorage.com) or a custom domain/r2.dev URL.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=
CLOUDFLARE_R2_PRIVATE_BUCKET=
